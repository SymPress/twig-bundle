<!doctype html>
<html {{ language_attributes() }}>
<head>
  <meta charset="{{ site.charset }}">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% block head %}{% endblock %}
  {{ wp_head() }}
</head>
<body {{ body_class() }}>
  {{ wp_body_open() }}
  {% block body %}{% endblock %}
  {{ wp_footer() }}
</body>
</html>
